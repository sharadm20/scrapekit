{
  "name": "scrapekit",
  "version": "1.0.0",
  "description": "A powerful and flexible web scraping toolkit that handles static and JavaScript-enabled sites with multiple export formats",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "scrapekit": "./dist/scraper.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/scraper.js",
    "dev": "ts-node src/scraper.ts",
    "scrape": "node dist/scraper.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "web-scraping",
    "scraper",
    "data-extraction",
    "export",
    "json",
    "excel",
    "mongodb",
    "xml",
    "puppeteer",
    "javascript",
    "dynamic-content",
    "cli-tool",
    "content-detection",
    "data-mining",
    "scraping-toolkit"
  ],
  "author": "Your Name",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/scrapekit.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/scrapekit/issues"
  },
  "homepage": "https://github.com/your-username/scrapekit#readme",
  "dependencies": {
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "puppeteer": "^24.30.0",
    "mongodb": "^7.0.0",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/xml2js": "^0.4.14",
    "@types/yargs": "^17.0.35",
    "@types/yargs-parser": "^21.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
